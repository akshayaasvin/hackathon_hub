# ─────────────────────────────────────────────────────────────────────────────
# ONE Vercel project, ONE set of variables — for Hackathon AND Webinar.
# Nothing here is duplicated per product: Razorpay keys belong to the Razorpay
# account, and the webhook + database are shared. See the /webinar routes.
# ─────────────────────────────────────────────────────────────────────────────

# Public — safe to expose to the browser. From Supabase Dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — NEVER add a NEXT_PUBLIC_ prefix to this or expose it to the client bundle.
# From Supabase Dashboard -> Project Settings -> API -> service_role key.
# Used by lib/supabase/admin.ts, imported only from app/api/** route handlers and
# server components, to:
#   - create the auth account for an applicant only at admin-approval time
#   - insert users/profile rows before a session exists (registration, approval)
#   - ban a rejected applicant's account at the auth layer
#   - write payment/registration state (Hackathon + Webinar) — browsers never can
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. From https://resend.com/api-keys after creating a Resend account.
# Used by lib/email.ts for every transactional email (application received,
# approved-with-credentials, rejected, changes-requested, webinar confirmation).
RESEND_API_KEY=

# Server-only. The "from" address for the emails above, e.g.
# "HackathonHub <onboarding@resend.dev>" (works out of the box for testing;
# use a verified domain for production).
RESEND_FROM_EMAIL=

# Server-only. API Key ID / Secret from Razorpay Dashboard -> Settings -> API Keys.
# ONE pair serves Hackathon and Webinar payments (keys are per Razorpay account and
# per mode — live keys for production, test keys for local/preview). Used by
# lib/razorpay.ts to create orders and to verify payments server-side.
# Required for any payment to work — without these, create-order returns a 501.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Server-only. Signing secret for the ONE webhook you create in Razorpay Dashboard ->
# Settings -> Webhooks:
#     URL:    https://hackathon.adz4needz.com/api/webhooks/razorpay
#     Events: payment.captured, order.paid, payment.failed
# (You type this secret yourself when creating the webhook, then paste the same value here.)
# Payments are ALSO confirmed by the server-side verify/sync routes, so a late or
# missing webhook no longer strands a paid registration — but do configure it.
RAZORPAY_WEBHOOK_SECRET=

# Public — the production domain, no trailing slash:  https://hackathon.adz4needz.com
# Used as the emailRedirectTo base for Supabase Auth confirmation emails, and (on the
# Vercel PRODUCTION deployment only) middleware redirects every other hostname — e.g.
# <project>.vercel.app — to it, because Razorpay only accepts checkouts from the
# domain registered on your account. Set it only AFTER hackathon.adz4needz.com is
# attached to this Vercel project.
NEXT_PUBLIC_SITE_URL=

# Public — safe to expose to the browser. Full international format (country
# code + number, no + or spaces, e.g. 918553451935). Used by the floating
# WhatsApp support button (components/WhatsAppButton.tsx) rendered site-wide.
NEXT_PUBLIC_WHATSAPP_SUPPORT_NUMBER=
